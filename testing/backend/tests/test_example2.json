{
    "services": [
        "backend",
        "auth-postgres",
        "movies-postgres"
    ],
    "requests": [
        {
            "method": "GET",
            "url": "/movieAPI/health",
            "expected_status": 200,
            "expected_response": 
            {
                "message": "API is healthy!",
                "backendAvailable": true,
                "importedMoviesAvailable": true,
                "authDBAvailable": true,
                "moviesDBAvailable": true,
                "recommendationsDBAvailable": false
            }
        },
        {
            "method": "GET",
            "url": "/movieAPI/movies?limit=0",
            "expected_status": 400,
            "expected_response": "invalid movie pagination: limit must be between 1 and 100\n"
        },
        {
            "method": "GET",
            "url": "/movieAPI/movies?limit=101",
            "expected_status": 400,
            "expected_response": "invalid movie pagination: limit must be between 1 and 100\n"
        },
        {
            "method": "GET",
            "url": "/movieAPI/movies?offset=-1",
            "expected_status": 400,
            "expected_response": "invalid movie pagination: offset must be a non-negative integer\n"
        }
    ]
}
