{
    "services": [
        "backend",
        "auth-postgres",
        "movies-postgres",
        "recommendations-postgres"
    ],
    "defiled_dbs": [
        "auth-postgres",
        "recommendations-postgres"
    ],
    "requests": [
        {
            "method": "POST",
            "url": "/movieAPI/signup",
            "body": {
                "userName": "recommendations-integration-user",
                "password": "StrongPassword123!"
            },
            "expected_status": 201,
            "expected_response": {
                "success": true
            },
            "expected_response_subset": true
        },
        {
            "method": "POST",
            "url": "/movieAPI/login",
            "body": {
                "userName": "recommendations-integration-user",
                "password": "StrongPassword123!"
            },
            "expected_status": 200,
            "expected_response": {
                "loggedIn": true
            },
            "expected_response_subset": true,
            "expected_cookies": {
                "access_token": true
            }
        },
        {
            "method": "GET",
            "url": "/movieAPI/session",
            "expected_status": 200,
            "expected_response": {
                "loggedIn": true,
                "username": "recommendations-integration-user"
            },
            "expected_response_subset": true,
            "required_response_fields": [
                "userId",
                "username"
            ]
        },
        {
            "method": "GET",
            "url": "/movieAPI/recommendations",
            "expected_status": 200,
            "expected_response": {
                "status": "empty"
            },
            "expected_response_subset": true,
            "required_response_fields": [
                "status",
                "movies"
            ]
        },
        {
            "method": "GET",
            "url": "/movieAPI/users?search=integration-user",
            "expected_status": 200,
            "expected_response": [],
            "expected_response_non_empty": true,
            "required_response_fields": [
            "id",
            "username"
            ]
        },
        {
            "method": "GET",
            "url": "/movieAPI/users/not-a-uuid/list",
            "expected_status": 400,
            "expected_response": "userId must be a valid UUID\n"
        },
        {
            "method": "GET",
            "url": "/movieAPI/my-list",
            "expected_status": 200,
            "expected_response": []
        },
        {
            "method": "GET",
            "url": "/movieAPI/movies?limit=1",
            "expected_status": 200,
            "expected_response": [],
            "expected_response_non_empty": true,
            "required_response_fields": [
                "tmdbId",
                "title"
            ],
            "capture_response": {
                "movieId": "[0]['tmdbId']"
            }
        },
        {
            "method": "POST",
            "url": "/movieAPI/my-list",
            "body": {
                "tmdbId": "{{movieId}}"
            },
            "expected_status": 201,
            "expected_response": {},
            "expected_response_subset": true,
            "expected_response_non_empty": true
        },
        {
            "method": "GET",
            "url": "/movieAPI/my-list",
            "expected_status": 200,
            "expected_response": [],
            "expected_response_non_empty": true,
            "required_response_fields": [
                "tmdbId",
                "title"
            ]
        },
        {
            "method": "DELETE",
            "url": "/movieAPI/my-list/{{movieId}}",
            "expected_status": 200,
            "expected_response": {
                "success": true
            }
        },
        {
            "method": "POST",
            "url": "/movieAPI/logout",
            "expected_status": 200,
            "expected_response": {
                "success": true
            },
            "expected_response_subset": true,
            "expected_cookies": {
                "access_token": false
            }
        },
        {
            "method": "GET",
            "url": "/movieAPI/session",
            "expected_status": 401,
            "expected_response": "authentication required\n"
        },
        {
            "method": "GET",
            "url": "/movieAPI/recommendations",
            "expected_status": 401,
            "expected_response": "authentication required\n"
        }
    ]
}
