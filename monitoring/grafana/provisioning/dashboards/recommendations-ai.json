{
  "uid": "movierec-recommendations-ai",
  "title": "MovieRec - Recommendations and AI",
  "tags": ["movierec", "ai", "recommendations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Model readiness",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "movierec_model_ready", "legendFormat": "{{model_type}} · {{model}}", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {"0": {"text": "NOT READY"}, "1": {"text": "READY"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "name"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Model request rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum by (model_type, model, operation, result) (movierec_model_requests_total)",
          "legendFormat": "{{model_type}} · {{model}} · {{operation}} · {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Model latency (p95)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, model_type, model, operation, result) (movierec_model_request_duration_seconds_bucket))",
          "legendFormat": "{{model_type}} · {{model}} · {{operation}} · {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 7}
    },
    {
      "id": 4,
      "title": "Recommendation pipeline totals",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum by (operation, result) (movierec_recommendation_requests_total)",
          "legendFormat": "{{operation}} · {{result}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "operation": 0,
              "result": 1,
              "Value": 2
            }
          }
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "id": 5,
      "title": "Chat pipeline latency (p95)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation, result) (movierec_recommendation_request_duration_seconds_bucket))",
          "legendFormat": "{{operation}} · {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "id": 6,
      "title": "Background refresh outcomes",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum by (operation, result) (movierec_recommendation_requests_total{operation=\"refresh\"})",
          "legendFormat": "{{operation}} · {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "req"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
    }
  ]
}
