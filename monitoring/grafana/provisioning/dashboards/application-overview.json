{
  "uid": "movierec-application",
  "title": "MovieRec - Application overview",
  "tags": ["movierec", "application"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "query": "label_values(movierec_http_requests_total, service)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "User-facing requests",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum(movierec_http_requests_total{service=\"gateway\"}) or vector(0)",
          "legendFormat": "gateway total",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "req"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Cumulative requests by service and route",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum by (service, method, route, status_class) (movierec_http_requests_total{service=~\"$service\",method!=\"OPTIONS\"})",
          "legendFormat": "{{service}} · {{method}} {{route}} · {{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Request latency (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, service, method, route) (movierec_http_request_duration_seconds_bucket{service=~\"$service\",method!=\"OPTIONS\"}))",
          "legendFormat": "p50 · {{service}} · {{method}} {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, service, method, route) (movierec_http_request_duration_seconds_bucket{service=~\"$service\",method!=\"OPTIONS\"}))",
          "legendFormat": "p95 · {{service}} · {{method}} {{route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, service, method, route) (movierec_http_request_duration_seconds_bucket{service=~\"$service\",method!=\"OPTIONS\"}))",
          "legendFormat": "p99 · {{service}} · {{method}} {{route}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Errors by service",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "sum by (service, route, status_class) (movierec_http_requests_total{service=~\"$service\",method!=\"OPTIONS\",status_class=~\"4xx|5xx\"})",
          "legendFormat": "{{service}} · {{route}} · {{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "req"}, "overrides": []},
      "options": {"tooltip": {"mode": "multi", "sort": "desc"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17}
    },
    {
      "id": 5,
      "title": "Service availability",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "expr": "movierec_database_available",
          "legendFormat": "{{database}} database",
          "refId": "A"
        },
        {
          "expr": "movierec_model_ready",
          "legendFormat": "{{model_type}} model",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "name"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17}
    }
  ]
}
