{
  "uid": "movierec-api",
  "title": "MovieRec API",
  "tags": ["movierec", "api"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum by (route, method) (rate(http_requests_total[5m]))", "legendFormat": "{{method}} {{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "5xx responses per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum by (route) (rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "{{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "Request latency (p95)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9}
    }
  ]
}
