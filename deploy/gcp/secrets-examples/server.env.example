# `make glean-vars` copies this file when needed and fills discovered GCP settings.
# VM zones and model GPU settings are discovered when the VMs exist; this zone is for a fresh deployment.
# GCP_PROJECT_ID is read from the active gcloud project and GCP_REGION is derived from GCP_ZONE.
GCP_ZONE=europe-west4-b
MOVIEREC_RESOURCE_NAME=movierec

# Defaults for Make targets. Override these on the command line when needed.
TF_PARALLELISM=2
DOCKER_MAX_CONCURRENT_UPLOADS=2
GPU=auto
GPU_TYPE=nvidia-tesla-t4
GPU_MACHINE_TYPE=
GPU_COUNT=1
GPU_REGION=europe
MODEL_ONLY=0
TF_AUTO_APPROVE=0
SCOPE=app-db
IMAGE_TAG=
PUBLIC_HOST=
NAMESPACE=movierec
TAIL_LINES=100
FOLLOW=0
