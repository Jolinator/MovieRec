# `make secrets-init` copies this to deploy/gcp/secrets/server.env and fills TF_VAR_project_id from gcloud.
# Adjust GCP_REGION/GCP_ZONE here if needed before running make secrets-init.
TF_VAR_project_id=your-project-id
GCP_REGION=europe-west4
GCP_ZONE=europe-west4-b
MOVIEREC_RESOURCE_NAME=movierec
